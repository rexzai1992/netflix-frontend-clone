{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "netflix-content-studio",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "netflix-content-studio",
      "database_id": "dd3c6988-a36e-4b9e-a48a-a7a5ad37f724",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "netflix-content-studio-media"
    }
  ],
  "vars": {
    "APP_NAME": "StreamFlix",
    "SESSION_TTL_SECONDS": "43200"
  },
  "observability": {
    "enabled": true
  }
}
